<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign since_year = include.since_year | default: site.announcements.since_year | plus: 0 %}
    {% assign displayed_news = 0 %}
    {% for item in news %}
      {% assign item_year = item.date | date: '%Y' | plus: 0 %}
      {% if since_year == blank or item_year >= since_year %}
        {% assign displayed_news = displayed_news | plus: 1 %}
      {% endif %}
    {% endfor %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and displayed_news > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign shown_news = 0 %}
        {% for item in news %}
          {% assign item_year = item.date | date: '%Y' | plus: 0 %}
          {% if since_year == blank or item_year >= since_year %}
            {% if include.limit and site.announcements.limit and shown_news >= site.announcements.limit %}
              {% break %}
            {% endif %}
            <tr>
              <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
            {% assign shown_news = shown_news | plus: 1 %}
          {% endif %}
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
